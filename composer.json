{
    "name": "ailuracode/wappify",
    "type": "library",
    "license": "MIT",
    "version": "v1.0.0",
    "description": "Wappify is a package that allows you to receive messages to WhatsApp using the WhatsApp Cloud API for Laravel.",
    "keywords": [
        "whatsapp",
        "laravel"
    ],
    "authors": [
        {
            "name": "AiluraCode"
        }
    ],
    "require": {
        "php": "^8.2",
        "netflie/whatsapp-cloud-api": "^2.0",
        "spatie/laravel-medialibrary": "^11|^12",
        "tightenco/parental": "^1.6",
        "spatie/laravel-model-states": "~2.12,<2.14.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5.50",
        "phpstan/phpstan": "^2.0",
        "orchestra/testbench": "^10.0",
        "laravel/framework": "^12.61.1",
        "laravel/pint": "^1.32",
        "rector/rector": "^2.0",
        "driftingly/rector-laravel": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "larastan/larastan": "^3.0",
        "barryvdh/laravel-ide-helper": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "AiluraCode\\Wappify\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AiluraCode\\Wappify\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "phpro/grumphp": true
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan-src": "phpstan analyse --configuration=phpstan.neon --memory-limit=512M",
        "phpstan-tests": "phpstan analyse --configuration=phpstan-tests.neon --memory-limit=512M",
        "phpstan": [
            "@phpstan-src",
            "@phpstan-tests"
        ],
        "pint": "pint --test",
        "pint:fix": "pint",
        "rector": "vendor/bin/rector process",
        "rector:dry-run": "vendor/bin/rector process --dry-run"
    }
}
